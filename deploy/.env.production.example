# Copia este archivo como .env.production en el servidor y complétalo.
# No lo subas a git.

# Dominio público. Sin dominio propio, sslip.io es gratis y no requiere cuenta:
# la IP 64.176.27.197 se escribe 64-176-27-197.sslip.io
SITE_DOMAIN=64-176-27-197.sslip.io
NEXT_PUBLIC_BASE_URL=https://64-176-27-197.sslip.io

# Secreto de las sesiones del equipo. Generar con:
#   openssl rand -hex 32
AUTH_SECRET=

# Opcionales
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
